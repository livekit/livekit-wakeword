# M5Stack Tab5 (ESP32-P4, 16 MB flash, 32 MB PSRAM). Wi-Fi is its ESP32-C6, reached over SDIO with
# esp_hosted (its Tab5 preset: pins and C6 reset); the C6 must run a matching esp_hosted slave
# firmware.
CONFIG_LK_EXAMPLE_BOARD_M5STACK_TAB5=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_SPIRAM_SPEED_200M=y
CONFIG_SLAVE_IDF_TARGET_ESP32C6=y
CONFIG_ESP_HOSTED_CP_TARGET_ESP32C6=y
CONFIG_ESP32P4_TAB5_C6_BOARD=y
CONFIG_ESP_HOSTED_AUTO_CALL_INIT_BEFORE_APP_MAIN=n
